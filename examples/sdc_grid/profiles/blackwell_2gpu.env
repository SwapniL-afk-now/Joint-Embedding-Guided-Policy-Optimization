#!/usr/bin/env bash
# examples/sdc_grid/profiles/blackwell_2gpu.env
#
# Environment profile for THIS box: 4x NVIDIA RTX PRO 6000 Blackwell Server Edition
# (sm_120, 97887 MiB each, driver 580.178.04, PCIe PHB only - no NVLink).
# We use GPU 0 and 1 only; GPU 2 and 3 are usually occupied by another job.
#
# The launcher defaults in examples/sdc_grid/common.sh target 4x H200 and are WRONG
# here. This profile only overrides HARDWARE / PATH / RUNTIME settings. It changes
# no learning-relevant hyperparameter, so the arms stay comparable with each other.
#
# Usage:
#   source examples/sdc_grid/profiles/blackwell_2gpu.env
#   bash examples/sdc_grid/sdc_tr/drgrpo_a0.5.sh --dry-run
# or simply:
#   bash examples/sdc_grid/profiles/run_blackwell_2gpu.sh sdc_tr/drgrpo_a0.5.sh --dry-run
#
# Every value uses ${VAR:-default}, so anything exported before sourcing still wins.

_SDC_PROFILE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd)"
_SDC_REPO_ROOT="$(cd -- "${_SDC_PROFILE_DIR}/../../.." && pwd)"

# ── Working stack on this box ────────────────────────────────────────────────
# This repo's own .venv has a BROKEN torch (undefined symbol: ncclCommResume).
# The GXPO speed-audit venv has torch 2.9.1+cu128 (arch list includes sm_120),
# flash_attn 2.8.3, liger-kernel, vllm 0.16.0, flashinfer, ray. Verified working.
GXPO_ROOT="${GXPO_ROOT:-/office/dev_workspace/swapnil/gradient-extrapolation-based-policy-optimization-gxpo-speed-audit}"
export PYTHON_BIN="${PYTHON_BIN:-${GXPO_ROOT}/.venv/bin/python}"
export PYTHONNOUSERSITE=1

# ── GPUs / parallelism ───────────────────────────────────────────────────────
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"
export NNODES="${NNODES:-1}"
export NDEVICES_PER_NODE="${NDEVICES_PER_NODE:-2}"
export FSDP_SIZE="${FSDP_SIZE:-2}"

# ── Attention ────────────────────────────────────────────────────────────────
# FlashAttention-3 is NOT installed here and has no sm_120 kernels; flash_attn
# (FA2) 2.8.3 is installed and its forward was verified on this GPU.
export ACTOR_ATTENTION_IMPL="${ACTOR_ATTENTION_IMPL:-flash_attention_2}"
export MODEL_DTYPE="${MODEL_DTYPE:-bf16}"

# ── CRITICAL: libcudart.so.13 shim ───────────────────────────────────────────
# flash_attn_2_cuda.so in that venv was built against CUDA 13, but torch is
# cu12.8, so `import flash_attn` dies with
#   ImportError: libcudart.so.13: cannot open shared object file
# vLLM ALSO imports flash_attn (rotary embedding), so without this the vLLM
# engine core fails to start. cudart13/ holds a single symlink to the CUDA 13
# runtime shipped inside that venv (site-packages/nvidia/cu13/lib). We add ONLY
# libcudart.so.13 - putting the whole cu13 lib dir on LD_LIBRARY_PATH would also
# shadow libcufft.so.12 / libcurand.so.10 / libcusparse.so.12 / libnccl for the
# cu12.8 torch build, which is how you get "undefined symbol: ncclCommResume".
export LD_LIBRARY_PATH="${_SDC_PROFILE_DIR}/cudart13${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Disable common.sh's own CUDA-13 library injection (its dist-packages path does
# not exist here anyway) and its CUDA-13 nvcc on PATH: nvcc 13 against a cu12.8
# torch is a mismatch we do not want in JIT paths.
export LOCAL_CUDA_LIB_ROOT="${LOCAL_CUDA_LIB_ROOT:-/nonexistent/sdc-profile-disabled}"
export GXPO_CUDA_HOME="${GXPO_CUDA_HOME:-/nonexistent/sdc-profile-disabled}"
# There is no .venv-h200 here; keep common.sh from picking a phantom interpreter.
export H200_REPO_ROOT="${H200_REPO_ROOT:-${GXPO_ROOT}}"
export H200_VENV_ROOT="${H200_VENV_ROOT:-/nonexistent/sdc-profile-disabled}"
export H200_SITE_PACKAGES="${H200_SITE_PACKAGES:-${GXPO_ROOT}/.venv/lib/python3.12/site-packages}"

# Triton JITs a CUDA driver helper at vLLM startup and needs Python.h, which the
# host python3.12 runtime omits. These staged headers exist and are used as-is.
export PYTHON_DEV_INCLUDE_ROOT="${PYTHON_DEV_INCLUDE_ROOT:-${GXPO_ROOT}/.python-dev/usr/include}"

# ── Assets (the /workspace paths in common.sh do not exist on this box) ──────
export MODEL_PATH="${MODEL_PATH:-${GXPO_ROOT}/models/Qwen2.5-Math-1.5B-Instruct}"
export GXPO_DATA_ROOT="${GXPO_DATA_ROOT:-${GXPO_ROOT}/Code/SFPO/data}"
export SDC_VAL_CACHE_ROOT="${SDC_VAL_CACHE_ROOT:-${_SDC_REPO_ROOT}/data/sdc_validation_normalized}"

# ── vLLM / backend settings for sm_120 ───────────────────────────────────────
# Validated: with VLLM_ATTENTION_BACKEND=FLASHINFER, vLLM 0.16.0 still reported
#   "Using FLASH_ATTN attention backend out of potential backends:
#    ['FLASH_ATTN', 'FLASHINFER', 'TRITON_ATTN', 'FLEX_ATTENTION']"
# on sm_120, i.e. the env request did not take effect in the engine-core process.
# We therefore pin the backend that actually ran and generated correct text.
# Set VLLM_ATTENTION_BACKEND=FLASHINFER before sourcing if you want to retry it.
export VLLM_ATTENTION_BACKEND="${VLLM_ATTENTION_BACKEND:-FLASH_ATTN}"
export CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"
# vLLM 0.16 CUDA memory pools reject expandable_segments. Keep the split-size
# guard, but do not enable expandable segments on this profile.
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-max_split_size_mb:512}"
export MPLBACKEND=Agg
unset RAY_ADDRESS

# 96 GiB per GPU, not the H200's 141 GiB, and 2 GPUs must hold the actor,
# the reference model and BOTH SDC teacher sidecars. 0.80 leaves too little.
# See README.md for the arithmetic.
export ROLLOUT_GPU_MEM_UTIL="${ROLLOUT_GPU_MEM_UTIL:-0.62}"
export ROLLOUT_MAX_NUM_SEQS="${ROLLOUT_MAX_NUM_SEQS:-1024}"
export ROLLOUT_MAX_NUM_BATCHED_TOKENS="${ROLLOUT_MAX_NUM_BATCHED_TOKENS:-131072}"

# No NVLink between these cards (PCIe host bridge only). NCCL all-reduce over 2
# ranks was verified working; uncomment only if you see NCCL P2P hangs.
# export NCCL_P2P_DISABLE=1
# export NCCL_SHM_DISABLE=0
export NCCL_CUMEM_ENABLE="${NCCL_CUMEM_ENABLE:-0}"

# Caches inside the repo checkout, never in $HOME.
export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-${_SDC_REPO_ROOT}/.cache/triton}"
export HF_HOME="${HF_HOME:-${_SDC_REPO_ROOT}/.cache/huggingface}"
mkdir -p "${TRITON_CACHE_DIR}" "${HF_HOME}" 2>/dev/null || true

# ── Optional memory-relief knobs (NOT enabled: they change the comparison) ────
# Wall-clock on 2 sm_120 GPUs is roughly 3-4x the 4x H200 reference. If you must
# shorten a debugging run, override on the command line rather than here:
#   TOTAL_TRAINING_STEPS=5 TEST_FREQ=0 VAL_BEFORE_TRAIN=False SAVE_FREQ=0 \
#     bash examples/sdc_grid/profiles/run_blackwell_2gpu.sh sdc_tr/drgrpo_a0.5.sh
# If the actor OOMs, halve the per-GPU token budget first (it only changes the
# micro-batch split, not the math):
#   export PPO_MAX_TOKEN_LEN_PER_GPU=24576

unset _SDC_PROFILE_DIR _SDC_REPO_ROOT
